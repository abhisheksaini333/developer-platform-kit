{
  "realm": "platform-kit",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "developer"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "platform-portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4600/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:4600"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "portal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "platform-portal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Developer",
      "email": "developer@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "developer-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "developer"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "firstName": "Catalog",
      "lastName": "Viewer",
      "email": "viewer@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ]
}
